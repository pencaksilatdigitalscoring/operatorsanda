    window.setMatchStatus = function(idx, status) { 
        if(status === 'bertanding') { 
            if(window.state.bertandingIdx === idx) { window.broadcast('bertandingIdx', -1); } 
            else { 
                window.broadcast('bertandingIdx', idx); window.broadcast('idx', idx); 
                resetActiveMatchData(); // Deep reset saat LIVE partai baru
                const matchTimer = window.state.matches[idx].maxTimer || 120; window.broadcast('timer', matchTimer); 
            } 
        } 
        else if(status === 'persiapan') { window.broadcast('persiapanIdx', (window.state.persiapanIdx === idx) ? -1 : idx); } 
        else if(status === 'selesai') { pendingFinishIdx = idx; openModal('modal-winner'); } 
    }

    window.finalizeWinner = function(side) {
        if(pendingFinishIdx < 0) return;
        const idx = pendingFinishIdx;
        const m = {...window.state.matches[idx]}; 
        m.status = 'selesai'; m.winnerSide = side; m.winner = (side === 'merah') ? m.m : m.b; 
        
        window.broadcast(`matches/${idx}`, m); 
        window.broadcast('monViewMode', 'winner');
        closeModal('modal-winner'); pendingFinishIdx = -1;
        setTimeout(() => propagateWinner(idx), 200); 
    }

    function propagateWinner(currentMatchIdx) {
        const m = window.state.matches[currentMatchIdx]; if (!m.nextP) return; 
        const nextIdx = m.nextP.p - 1; const nextMatch = { ...window.state.matches[nextIdx] }; 
        const winnerName = m.winner; const winnerKont = (m.winnerSide === 'biru') ? m.kb : m.km; 
        
        if (m.nextP.side === 'biru') { nextMatch.b = winnerName; nextMatch.kb = winnerKont; } 
        else { nextMatch.m = winnerName; nextMatch.km = winnerKont; } 
        
        const opponent = (m.nextP.side === 'biru') ? nextMatch.m : nextMatch.b; 
        if (opponent === "BYE" && winnerName !== "BYE") { 
            nextMatch.status = 'selesai'; nextMatch.winner = winnerName; nextMatch.winnerSide = m.nextP.side; 
            window.broadcast(`matches/${nextIdx}`, nextMatch); setTimeout(() => propagateWinner(nextIdx), 100); 
        } else { window.broadcast(`matches/${nextIdx}`, nextMatch); }
    }

