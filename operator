<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Operator Panel - WUSHU SANDA SCORING</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    
    <!-- Library SheetJS untuk Export & Import Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
        
        :root {
            --sat: env(safe-area-inset-top);
            --sab: env(safe-area-inset-bottom);
            --sal: env(safe-area-inset-left);
            --sar: env(safe-area-inset-right);
        }

        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #f1f5f9; 
            color: #0f172a; 
            margin: 0; 
            height: 100vh; 
            width: 100vw; 
            overflow: hidden; 
            -webkit-tap-highlight-color: transparent;
        }
        
        .custom-scroll { overflow-y: auto; overflow-x: hidden; }
        .custom-scroll::-webkit-scrollbar { width: 5px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .custom-scroll:hover::-webkit-scrollbar-thumb { background: #94a3b8; }

        .save-notif { 
            position: fixed; 
            top: calc(15px + var(--sat)); 
            right: calc(15px + var(--sar)); 
            background: #10b981; 
            color: white; 
            padding: 12px 18px; 
            border-radius: 8px; 
            font-weight: 700; 
            font-size: 13px;
            transform: translateY(-150%); 
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); 
            z-index: 60000; 
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        }
        .save-notif.show { transform: translateY(0); }

        .modal-overlay { 
            position: fixed; 
            inset: 0; 
            background: rgba(15, 23, 42, 0.85); 
            z-index: 50000; 
            display: none; 
            align-items: center; 
            justify-content: center; 
            padding: 20px; 
            backdrop-filter: blur(4px); 
        }
        .modal-overlay.active { display: flex; }

        .active-babak { 
            background-color: #0f172a !important; 
            color: white !important; 
            border-color: #0f172a !important; 
        }
        
        .status-online { background-color: #10b981; }
        .status-offline { background-color: #ef4444; animation: pulse-red 1.5s infinite; }
        @keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 5px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        .bottom-nav-safe { padding-bottom: calc(0.75rem + var(--sab)); }
        .header-safe {
            padding-top: calc(0.75rem + var(--sat));
            padding-left: calc(0.75rem + var(--sal));
            padding-right: calc(0.75rem + var(--sar));
        }

        #config-content {
            transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out, opacity 0.3s ease-in-out;
            overflow: hidden;
        }
        .config-hidden {
            max-height: 0px !important;
            padding-top: 0px !important;
            padding-bottom: 0px !important;
            opacity: 0;
            border: none !important;
        }
        .config-visible {
            max-height: 600px;
            opacity: 1;
        }
    </style>
</head>
<body class="flex flex-col h-screen w-screen bg-slate-100 overflow-hidden text-slate-800">

    <div id="save-ani" class="save-notif"><i class="fas fa-check-circle mr-2"></i> Sistem Tersinkronisasi</div>

    <!-- MODAL LOGOUT JURI (RESPONSIF) -->
    <div id="modal-logout-juri" class="modal-overlay">
        <div class="bg-white rounded-2xl p-6 w-full max-w-sm text-center shadow-2xl mx-auto border-t-4 border-amber-500 transform transition-all">
            <h2 class="font-black text-xl uppercase text-slate-800 mb-1">Status & Logout Juri</h2>
            <p class="text-[11px] text-slate-500 font-medium mb-5">Pilih juri yang online (hijau) untuk dikeluarkan dari sistem.</p>
            
            <div class="grid grid-cols-2 gap-3 mb-4">
                <button id="btn-lo-j1" onclick="logoutJuri(1)" class="bg-slate-100 text-slate-400 py-3 rounded-xl font-bold text-sm transition-colors border border-slate-200">Juri 1</button>
                <button id="btn-lo-j2" onclick="logoutJuri(2)" class="bg-slate-100 text-slate-400 py-3 rounded-xl font-bold text-sm transition-colors border border-slate-200">Juri 2</button>
                <button id="btn-lo-j3" onclick="logoutJuri(3)" class="bg-slate-100 text-slate-400 py-3 rounded-xl font-bold text-sm transition-colors border border-slate-200">Juri 3</button>
                <button id="btn-lo-j4" onclick="logoutJuri(4)" class="bg-slate-100 text-slate-400 py-3 rounded-xl font-bold text-sm transition-colors border border-slate-200">Juri 4</button>
                <button id="btn-lo-j5" onclick="logoutJuri(5)" class="col-span-2 bg-slate-100 text-slate-400 py-3 rounded-xl font-bold text-sm transition-colors border border-slate-200">Juri 5</button>
            </div>
            
            <button onclick="logoutJuri('all')" class="w-full bg-red-600 hover:bg-red-700 active:bg-red-800 text-white py-3 rounded-xl font-black uppercase text-sm mb-3 shadow-md transition-colors"><i class="fas fa-sign-out-alt mr-2"></i> Logout Semua Juri</button>
            <button onclick="closeModal('modal-logout-juri')" class="w-full bg-slate-50 text-slate-500 hover:text-slate-700 py-2 rounded-xl font-bold uppercase text-xs transition-colors">Tutup</button>
        </div>
    </div>

    <!-- MODAL KONFIRMASI KEPUTUSAN RONDE -->
    <div id="modal-confirm-round-winner" class="modal-overlay">
        <div class="bg-white rounded-2xl p-6 w-full max-w-sm text-center shadow-2xl mx-auto border-t-4 border-indigo-600 transform transition-all">
            <h2 class="font-black text-xl uppercase text-slate-800 mb-2">Konfirmasi Hasil Ronde</h2>
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 mb-5">
                <p class="text-xs text-slate-500 font-bold uppercase mb-1">Hasil Perhitungan Juri:</p>
                <div id="round-winner-text" class="text-2xl font-black text-slate-800 uppercase">-</div>
                <p id="round-winner-detail" class="text-[11.5px] text-slate-500 font-medium mt-2 bg-white inline-block px-3 py-1 rounded shadow-sm border border-slate-200"></p>
            </div>
            <div class="flex gap-3">
                <button onclick="closeModal('modal-confirm-round-winner')" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 py-3 rounded-xl font-bold uppercase text-xs transition-all border border-slate-200">Batal</button>
                <button onclick="confirmRoundDecision()" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-black uppercase text-xs shadow-md transition-all">Konfirmasi</button>
            </div>
        </div>
    </div>

    <!-- MODAL WINNER FINAL CONFIRMATION (MATCH) -->
    <div id="modal-winner" class="modal-overlay">
        <div class="bg-white rounded-2xl p-5 w-full max-w-sm text-center shadow-2xl mx-auto border-t-4 border-slate-800 transform transition-all">
            <h2 class="font-black text-xl uppercase text-slate-800 mb-1">Keputusan Akhir Partai</h2>
            <p class="text-[11px] text-slate-500 font-medium mb-5">Pilih pemenang partai ini untuk diperbarui ke database.</p>
            
            <div class="flex gap-3 mb-5">
                <button onclick="finalizeWinner('biru')" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl font-black uppercase text-sm shadow-lg transition-all border border-blue-700">
                    <i class="fas fa-trophy block text-2xl mb-1 text-blue-200"></i>
                    SUDUT BIRU
                </button>
                <button onclick="finalizeWinner('merah')" class="flex-1 bg-red-600 hover:bg-red-700 text-white p-3 rounded-xl font-black uppercase text-sm shadow-lg transition-all border border-red-700">
                    <i class="fas fa-trophy block text-2xl mb-1 text-red-200"></i>
                    SUDUT MERAH
                </button>
            </div>
            <button onclick="closeModal('modal-winner')" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-600 py-3 rounded-xl font-bold uppercase text-xs transition-all border border-slate-200">Batal</button>
        </div>
    </div>

    <!-- HEADER LAYOUT -->
    <div class="header-safe pb-3 bg-slate-900 text-white shadow-md flex justify-between items-center shrink-0 z-30">
        <div class="flex items-center gap-2.5">
            <div class="bg-red-600 p-2 rounded-lg shadow-inner flex items-center justify-center">
                <i class="fas fa-yin-yang text-lg text-white"></i>
            </div>
            <div>
                <h2 class="text-sm font-black uppercase tracking-wider leading-tight">Operator Sanda</h2>
                <p class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest mt-0.5">Scoring System</p>
            </div>
        </div>
        
        <div class="flex gap-2">
            <input type="file" id="import-excel-input" accept=".xlsx, .xls" class="hidden" onchange="handleJadwalExcelImport(event)">
            
            <button onclick="exportTemplateExcel()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-2 rounded-lg font-bold text-[10px] uppercase transition-colors shadow-sm hidden sm:block">
                Template Excel
            </button>
            <button onclick="document.getElementById('import-excel-input').click()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg font-bold text-[10px] uppercase transition-colors flex items-center gap-1.5 shadow-sm">
                <i class="fas fa-file-excel text-sm"></i> <span>Import Excel</span>
            </button>
        </div>
    </div>
    
    <!-- CONTROL STATION PANEL -->
    <div class="bg-white border-b border-slate-200 shadow-sm shrink-0 z-20 flex flex-col">
        <button onclick="toggleConfig()" class="w-full bg-slate-50 border-b border-slate-100 py-2.5 px-4 flex justify-between items-center text-[10px] font-black text-slate-600 uppercase tracking-widest hover:bg-slate-100 transition-colors">
            <span class="flex items-center gap-2"><i class="fas fa-sliders-h text-slate-400"></i> Kontrol & Konfigurasi Sistem</span>
            <i id="toggle-config-icon" class="fas fa-chevron-up transition-transform duration-300 text-slate-400"></i>
        </button>

        <div id="config-content" class="config-visible px-4 py-4 border-b border-slate-200">
            <div class="max-w-6xl mx-auto flex flex-col md:flex-row gap-5 md:gap-8 md:divide-x divide-slate-100">
                
                <!-- KIRI: Timer & Gap -->
                <div class="flex-1 md:pr-5 flex flex-col gap-3">
                    <div class="flex justify-between items-center mb-1">
                        <h3 class="text-[10px] font-black uppercase text-slate-400 tracking-widest flex items-center gap-1.5"><i class="fas fa-clock"></i> Pengaturan Waktu</h3>
                    </div>
                    
                    <div class="flex gap-2">
                        <div class="flex-1">
                            <select onchange="setMatchTimer(this.value)" class="bg-slate-50 border border-slate-300 text-xs font-bold rounded-lg px-2 py-2 w-full outline-none focus:border-blue-500 transition-all cursor-pointer">
                                <option value="120">2 Menit (Senior)</option>
                                <option value="90">1.5 Menit (Remaja)</option>
                                <option value="60">1 Menit (Junior)</option>
                            </select>
                        </div>
                        <div class="flex-1">
                            <select onchange="setPointGap(this.value)" id="op-gap-select" class="bg-slate-50 border border-slate-300 text-xs font-bold rounded-lg px-2 py-2 w-full outline-none focus:border-blue-500 transition-all cursor-pointer">
                                <option value="12">Gap 12 Poin</option>
                                <option value="10">Gap 10 Poin</option>
                                <option value="99">Tanpa Gap</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-xl border border-slate-200 mt-1">
                        <div class="text-4xl font-black text-slate-800 font-mono tracking-tighter w-24 text-center" id="op-timer-disp">02:00</div>
                        <div class="flex gap-2 pr-1">
                            <button onclick="timerCtrl('start')" class="bg-emerald-500 hover:bg-emerald-600 text-white w-12 h-10 rounded-lg font-black flex items-center justify-center text-sm shadow-sm transition-transform active:scale-95"><i class="fas fa-play"></i></button>
                            <button onclick="timerCtrl('stop')" class="bg-amber-500 hover:bg-amber-600 text-white w-12 h-10 rounded-lg font-black flex items-center justify-center text-sm shadow-sm transition-transform active:scale-95"><i class="fas fa-pause"></i></button>
                            <button onclick="timerCtrl('reset')" class="bg-rose-500 hover:bg-rose-600 text-white w-12 h-10 rounded-lg font-black flex items-center justify-center text-sm shadow-sm transition-transform active:scale-95"><i class="fas fa-undo"></i></button>
                        </div>
                    </div>
                </div>

                <!-- KANAN: Juri & Kontrol Ronde -->
                <div class="flex-1 md:pl-5 flex flex-col pt-3 md:pt-0 border-t md:border-t-0 border-slate-100">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-[10px] font-black uppercase text-slate-400 tracking-widest flex items-center gap-1.5"><i class="fas fa-tablet-alt"></i> Status Juri</h3>
                        <button onclick="openModal('modal-logout-juri')" class="text-[9px] bg-red-50 text-red-600 border border-red-200 px-2.5 py-1.5 rounded-md font-bold uppercase active:bg-red-100 shadow-sm active:scale-95 transition-all"><i class="fas fa-power-off mr-1"></i> Logout</button>
                    </div>
                    
                    <div class="flex justify-between gap-1.5 mb-4" id="juri-status-container">
                        <!-- Dinamis via JS -->
                    </div>

                    <h3 class="text-[10px] font-black uppercase text-slate-400 tracking-widest mb-2 flex items-center gap-1.5"><i class="fas fa-layer-group"></i> Kontrol Ronde</h3>
                    <div class="flex gap-2">
                        <button onclick="setRound(1)" id="op-btn-b1" class="flex-1 bg-white border border-slate-300 text-slate-500 py-2 rounded-lg text-[10px] font-black uppercase active:bg-slate-100 shadow-sm transition-colors">Ronde 1</button>
                        <button onclick="setRound(2)" id="op-btn-b2" class="flex-1 bg-white border border-slate-300 text-slate-500 py-2 rounded-lg text-[10px] font-black uppercase active:bg-slate-100 shadow-sm transition-colors">Ronde 2</button>
                        <button onclick="setRound(3)" id="op-btn-b3" class="flex-1 bg-white border border-slate-300 text-slate-500 py-2 rounded-lg text-[10px] font-black uppercase active:bg-slate-100 shadow-sm transition-colors">Ronde 3</button>
                    </div>

                    <div class="flex flex-col gap-2 mt-3">
                        <!-- TOMBOL KEPUTUSAN PEMENANG RONDE -->
                        <button onclick="previewRoundWinner()" class="w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white py-2.5 rounded-lg text-[11px] font-black uppercase shadow-md flex items-center justify-center transition-all active:scale-[0.98]">
                            Keputusan Pemenang Ronde Aktif
                        </button>
                        <!-- TOMBOL RESET NILAI JURI -->
                        <button onclick="resetSkorJuriConfirm()" class="w-full bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-100 active:bg-rose-200 py-2 rounded-lg text-[10px] font-black uppercase shadow-sm flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
                            <i class="fas fa-eraser"></i> Reset Nilai Juri (Jadikan 0)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- MATCH LIST AREA -->
    <div class="flex-1 overflow-y-auto custom-scroll relative bg-slate-100 z-0 flex flex-col pb-20">
        <!-- Filter Bar -->
        <div class="sticky top-0 bg-slate-100/95 backdrop-blur z-10 px-3 md:px-5 pt-3 pb-2 border-b border-slate-200">
            <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-2">
                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-lg border border-slate-200 shadow-sm flex-1 sm:max-w-xs">
                    <i class="fas fa-filter text-slate-400 text-[10px]"></i>
                    <select id="category-filter" onchange="renderOperatorTable()" class="bg-transparent border-none text-[11px] font-bold text-slate-700 outline-none w-full cursor-pointer appearance-none truncate">
                        <option value="ALL">SEMUA KELAS / KATEGORI</option>
                    </select>
                    <i class="fas fa-chevron-down text-slate-400 text-[9px]"></i>
                </div>
                <div class="flex items-center gap-2">
                    <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider bg-white px-3 py-2 rounded-lg border border-slate-200 shadow-sm">
                        Total: <span id="total-match-info" class="text-slate-800 font-black text-xs ml-1">0</span> Partai
                    </div>
                    <button onclick="deleteAllMatches()" class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 px-3 py-2 rounded-lg text-[10px] font-black uppercase transition-colors shadow-sm">
                        <i class="fas fa-trash-alt mr-1"></i> Kosongkan
                    </button>
                </div>
            </div>
        </div>

        <div class="px-3 md:px-5 pt-3 pb-6 max-w-5xl mx-auto w-full">
            <div id="operator-table-body" class="space-y-3 md:space-y-4">
                <!-- Data Match Dinamis -->
            </div>
        </div>
    </div>
    
    <!-- PAGINATION -->
    <div class="bg-white/95 backdrop-blur-md border-t border-slate-200 flex justify-between items-center z-[40000] absolute bottom-0 left-0 right-0 shadow-[0_-5px_15px_rgba(0,0,0,0.05)] bottom-nav-safe px-3 pt-3">
        <div class="max-w-5xl mx-auto w-full flex justify-between items-center gap-2">
            <button onclick="changeOperatorPage(-1)" class="bg-white hover:bg-slate-50 text-slate-600 border border-slate-300 px-4 md:px-6 py-2.5 rounded-lg text-[11px] font-black uppercase shadow-sm transition-all flex items-center gap-2">
                <i class="fas fa-chevron-left"></i> <span class="hidden sm:inline">SEBELUMNYA</span>
            </button>
            <span id="op-page-info" class="text-[11px] md:text-xs font-black text-slate-700 bg-slate-100 px-4 md:px-5 py-2 rounded-lg border border-slate-200">Hal 1 / 10</span>
            <button onclick="changeOperatorPage(1)" class="bg-white hover:bg-slate-50 text-slate-600 border border-slate-300 px-4 md:px-6 py-2.5 rounded-lg text-[11px] font-black uppercase shadow-sm transition-all flex items-center gap-2">
                <span class="hidden sm:inline">SELANJUTNYA</span> <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>

<script>
    window.toggleConfig = function() {
        const content = document.getElementById('config-content');
        const icon = document.getElementById('toggle-config-icon');
        if (content.classList.contains('config-visible')) {
            content.classList.remove('config-visible'); content.classList.add('config-hidden');
            icon.style.transform = 'rotate(180deg)';
        } else {
            content.classList.remove('config-hidden'); content.classList.add('config-visible');
            icon.style.transform = 'rotate(0deg)';
        }
    };
</script>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getDatabase, ref, set, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    const firebaseConfig = {
        apiKey: "AIzaSyCUhrQj0vxKYDtf1iSJVetY6gQ5K932blM",
        authDomain: "wushu-sanda-b85dc.firebaseapp.com",
        databaseURL: "https://wushu-sanda-b85dc-default-rtdb.asia-southeast1.firebasedatabase.app",
        projectId: "wushu-sanda-b85dc",
        storageBucket: "wushu-sanda-b85dc.firebasestorage.app",
        messagingSenderId: "335593032214",
        appId: "1:335593032214:web:65e2186bee003408c48337"
    };

    const app = initializeApp(firebaseConfig);
    const database = getDatabase(app);
    const dbRef = ref(database, 'wushu_sanda_scoring');

    // Struktur State Utama - Terhubung dengan Dewan & Juri
    const INITIAL_STATE = {
        timer: 120, babak: 1, isRunning: false, idx: 0, bertandingIdx: -1, persiapanIdx: -1,
        monViewMode: 'score', pointGap: 12,
        matches: Array.from({length: 200}, (_, i) => ({ 
            p: i+1, m: "", b: "", km: "", kb: "", cat: "SENIOR", kelas: "56KG", gender: "PUTRA", fase: "PENYISIHAN", status: 'idle',
            winner: "", winnerSide: "", maxBabak: 3, maxTimer: 120, nextP: null, beratB: "", beratM: ""
        })),
        merah: { baseScore: [0,0,0], actions: [], roundWins: [false,false,false], juri: { j1: [0,0,0], j2: [0,0,0], j3: [0,0,0], j4: [0,0,0], j5: [0,0,0] } },
        biru: { baseScore: [0,0,0], actions: [], roundWins: [false,false,false], juri: { j1: [0,0,0], j2: [0,0,0], j3: [0,0,0], j4: [0,0,0], j5: [0,0,0] } },
        juriStatus: { j1: false, j2: false, j3: false, j4: false, j5: false },
        forceLogoutJuri: false,
        roundDecision: [false, false, false]
    };

    window.state = INITIAL_STATE;
    let tInt = null;
    window.operatorPage = 0;
    let pendingFinishIdx = -1;
    let pendingRoundDecision = null;

    onValue(dbRef, (snapshot) => {
        const data = snapshot.val();
        if (data) { 
            window.state = data; 
            updateUI(); 
            updateLogoutModalUI(); // Update UI Modal Logout secara real-time
            renderOperatorTable();
            populateCategoryFilter();
        } else { 
            set(dbRef, INITIAL_STATE); 
        }
    });

    window.broadcast = function(path = "", value = null) {
        if (path !== "") { set(ref(database, 'wushu_sanda_scoring/' + path), value); } 
        else { set(dbRef, window.state); }
    }

    window.showNotif = function(customMsg) { 
        const n = document.getElementById('save-ani'); 
        n.innerHTML = customMsg || '<i class="fas fa-check-circle mr-2"></i> Tersimpan';
        n.classList.add('show'); 
        setTimeout(() => n.classList.remove('show'), 2500); 
    }

    window.openModal = function(id) { document.getElementById(id).classList.add('active'); }
    window.closeModal = function(id) { document.getElementById(id).classList.remove('active'); }

    window.updateUI = function() {
        const tStr = (s) => `${Math.floor(s/60).toString().padStart(2,'0')}:${((s||0)%60).toString().padStart(2,'0')}`;
        const el = document.getElementById('op-timer-disp'); 
        if(el) el.innerText = tStr(window.state.timer);
        
        [1,2,3].forEach(b => { 
            const btn = document.getElementById('op-btn-b' + b); 
            if(btn) btn.classList.toggle('active-babak', window.state.babak === b); 
        });

        const gapEl = document.getElementById('op-gap-select');
