        ws['!cols'] = [{ wch: 5 }, { wch: 8 }, { wch: 15 }, { wch: 25 }, { wch: 25 }, { wch: 20 }, { wch: 10 }, { wch: 25 }, { wch: 20 }, { wch: 10 }];
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Jadwal_Sanda"); XLSX.writeFile(wb, "Template_Jadwal_Sanda.xlsx");
    }

    // Parser Excel yang Diperbarui (Lebih cerdas & komprehensif)
    window.handleJadwalExcelImport = function(event) {
        const file = event.target.files[0]; if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, {type: 'array'});
                const jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]], { defval: "" });

                let imported = [];
                jsonData.forEach(row => {
                    const getVal = (arr) => { 
                        for(let k of Object.keys(row)) { 
                            if(arr.some(pn => k.toUpperCase().includes(pn))) return row[k].toString().trim(); 
                        } 
                        return ""; 
                    };
                    
                    let p = parseInt(getVal(["PARTAI", "NO"])); 
                    if(isNaN(p) || p <= 0) return;

                    let bName = getVal(["NAMA PESERTA (BIRU)", "NAMA ATLET (BIRU)", "NAMA BIRU", "ATLET BIRU", "BIRU"]); 
                    let mName = getVal(["NAMA PESERTA (MERAH)", "NAMA ATLET (MERAH)", "NAMA MERAH", "ATLET MERAH", "MERAH"]);
                    
                    if (!bName) { bName = "BYE"; } 
                    if (!mName) { mName = "BYE"; }
                    
                    let katString = getVal(["KATEGORI", "KELAS TANDING"]) || "56KG SENIOR PUTRA"; 
                    let kParts = katString.split(" ");
                    let kelas = kParts[0] || "56KG"; 
                    let gender = katString.toUpperCase().includes("PUTRI") ? "PUTRI" : "PUTRA"; 
                    let cat = kParts.slice(1).join(" ").replace(/(PUTRA|PUTRI)/ig, '').trim() || "SENIOR";

                    let kb = getVal(["KONTINGEN (BIRU)", "KONTINGEN BIRU", "SASANA (BIRU)", "TIM BIRU", "ASAL BIRU"]).toUpperCase();
                    let km = getVal(["KONTINGEN (MERAH)", "KONTINGEN MERAH", "SASANA (MERAH)", "TIM MERAH", "ASAL MERAH"]).toUpperCase();
                    
                    let beratB = getVal(["BB (BIRU)", "BB BIRU", "BERAT BADAN (BIRU)", "BERAT (BIRU)"]);
                    let beratM = getVal(["BB (MERAH)", "BB MERAH", "BERAT BADAN (MERAH)", "BERAT (MERAH)"]);

                    imported.push({ 
                        p: p, 
                        fase: (getVal(["FASE", "BABAK"]) || "PENYISIHAN").toUpperCase(), 
                        kelas: kelas.toUpperCase(), 
                        cat: cat.toUpperCase(), 
                        gender: gender, 
                        b: bName.toUpperCase(), 
                        kb: kb || "-", 
                        beratB: beratB || "-", 
                        m: mName.toUpperCase(), 
                        km: km || "-", 
                        beratM: beratM || "-", 
                        status: 'idle' 
                    });
                });

                if (imported.length > 0) {
                    let curr = [...window.state.matches];
                    imported.forEach(m => { 
                        if (m.p-1 >= 0 && m.p-1 < curr.length) curr[m.p-1] = { ...curr[m.p-1], ...m }; 
                    });
                    window.broadcast('matches', curr); 
                    showNotif(`${imported.length} Partai Diimpor!`);
                }
            } catch (err) { alert("Format Excel tidak sesuai atau gagal dibaca."); }
            event.target.value = ""; // Reset input
        };
        reader.readAsArrayBuffer(file);
    }
</script>
