    // --- FITUR PREVIEW & KEPUTUSAN PEMENANG RONDE ---
    window.previewRoundWinner = function() {
        if(window.state.bertandingIdx === -1) return alert("Belum ada partai yang aktif tanding (LIVE)!");
        if(window.state.isRunning) return alert("Hentikan (Pause) waktu terlebih dahulu sebelum mengambil keputusan ronde!");

        const state = window.state;
        const r = (state.babak || 1) - 1; // 0 for Round 1

        // Kalkulasi Hukuman Lawan (Penalti bernilai +2 untuk lawan)
        const getPen = (side) => {
            const opp = side === 'merah' ? 'biru' : 'merah';
            const acts = state[opp].actions || [];
            return (acts.filter(a => a.type === 'caution' && a.round === r+1).length * 2) + 
                   (acts.filter(a => a.type === '8count' && a.round === r+1).length * 2) + 
                   (acts.filter(a => a.type === 'ringout' && a.round === r+1).length * 2);
        };

        const penM = getPen('merah');
        const penB = getPen('biru');

        let mVotes = 0; let bVotes = 0;

        // Kalkulasi Nilai per Juri & Tentukan Pemenang per Juri
        for (let i = 1; i <= 5; i++) {
            const jKey = 'j'+i;
            const rawM = (state.merah.juri && state.merah.juri[jKey]) ? (state.merah.juri[jKey][r] || 0) : 0;
            const rawB = (state.biru.juri && state.biru.juri[jKey]) ? (state.biru.juri[jKey][r] || 0) : 0;
            const baseM = (state.merah.baseScore) ? (state.merah.baseScore[r] || 0) : 0;
            const baseB = (state.biru.baseScore) ? (state.biru.baseScore[r] || 0) : 0;

            const totalM = rawM + baseM + penM;
            const totalB = rawB + baseB + penB;

            if (totalM > totalB) mVotes++;
            else if (totalB > totalM) bVotes++;
        }

        const mWinsRound = mVotes > bVotes;
        const bWinsRound = bVotes > mVotes;
        
        let winnerText = mWinsRound ? "SUDUT MERAH" : (bWinsRound ? "SUDUT BIRU" : "SERI (TIE)");
        let colorClass = mWinsRound ? "text-red-600" : (bWinsRound ? "text-blue-600" : "text-slate-600");
        
        // Update UI Modal
        document.getElementById('round-winner-text').innerText = winnerText;
        document.getElementById('round-winner-text').className = `text-2xl font-black uppercase mt-1 ${colorClass}`;
        document.getElementById('round-winner-detail').innerText = `Didukung oleh: ${mVotes} Juri Merah  |  ${bVotes} Juri Biru`;

        // Simpan Hasil ke memory sebelum dikonfirmasi
        pendingRoundDecision = { r: r, mWinsRound: mWinsRound, bWinsRound: bWinsRound, text: winnerText };

        openModal('modal-confirm-round-winner');
    }

